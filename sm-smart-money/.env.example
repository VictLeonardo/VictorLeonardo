# ------------------------------------------------------------------ banco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sm_smart_money?schema=public"
# Conexao sem pool, usada pelas migrations. Em banco gerenciado (Neon, Supabase)
# e' a string "direct" (a que NAO tem "-pooler" no host); num Postgres comum,
# repita a mesma DATABASE_URL.
#
# Obrigatoria tambem na Vercel: o `vercel-build` roda `prisma migrate deploy`,
# e o schema.prisma le' esta variavel em `directUrl`. Ela nao passa pelo
# schema de validacao do env.ts, entao faltando ela o build quebra com erro do
# Prisma, nao com a mensagem amigavel das outras.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sm_smart_money?schema=public"

# ------------------------------------------------------------------ auth
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-de-pelo-menos-32-caracteres"
# Duracao do access token (minutos) e do refresh token (dias).
AUTH_ACCESS_MINUTES="15"
AUTH_REFRESH_DAYS="7"
# "Lembrar de mim" estende o refresh token para este numero de dias.
AUTH_REMEMBER_DAYS="30"

# --------------------------------------------------------- portas no host
# Trocar aqui evita conflito com outros projetos rodando na mesma maquina.
APP_PORT="3000"
POSTGRES_PORT="5432"
WAHA_PORT="3001"

# ------------------------------------------------------------------ app
# Endereco publico da plataforma. Base dos links de e-mail, do retorno do
# Stripe e dos convites -- e tambem define ONDE a aplicacao e' servida: o
# caminho desta URL vira o `basePath` do Next. Na raiz do host:
#   NEXT_PUBLIC_APP_URL="https://portal.smpartner.com.br"
# Dentro de um caminho do site institucional:
#   NEXT_PUBLIC_APP_URL="https://smpartner.com.br/viplounge"
# Nesse caso a plataforma responde apenas em /viplounge/* -- a raiz do dominio
# continua sendo do site institucional. Ver src/lib/rotas.ts.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Prefixo explicito, para build local ou preview em que a URL publica nao
# reflete o caminho final. Vazio ou ausente: deriva de NEXT_PUBLIC_APP_URL.
# NEXT_BASE_PATH="/viplounge"
# Convite do grupo. Sem prefixo publico: e' entrega de assinante, nao de
# visitante. Vai no e-mail de boas-vindas, no botao do portal e na mensagem de
# WhatsApp que quem paga recebe -- um endereco so', para os tres nunca
# divergirem. Redefinir o link no WhatsApp exige atualizar aqui.
WHATSAPP_GROUP_URL="https://chat.whatsapp.com/exemplo"

# ------------------------------------------------------------------ e-mail (SMTP)
# Qualquer servidor SMTP serve. No Resend o usuario e' a palavra "resend", nao um
# endereco, e a senha e' a API key (re_...). O remetente do MAIL_FROM precisa
# estar num dominio verificado no painel do Resend, senao o envio para terceiros
# e' recusado.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
# Ausente, o modo sai da porta: 465 e' TLS implicito, 587 e 25 usam STARTTLS.
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASSWORD=""
MAIL_FROM="SM Smart Money <contato@smboard.com.br>"
# Destinatario dos alertas operacionais (WAHA offline, falhas de disparo).
ADMIN_ALERT_EMAIL="admin@smboard.com.br"

# -------------------------------------------------------- Armazenamento (Blob)
# A Vercel preenche sozinha ao conectar um Blob ao projeto. O envio de arquivo
# pelo navegador precisa do token de leitura e escrita; sem ele o botao de
# enviar nem aparece, e so' sobra colar endereco a mao.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
# A Vercel tambem deixa VERCEL_OIDC_TOKEN ao conectar a loja. Nao crie a mao:
# o envio pelo navegador precisa do token de leitura e escrita, nao dele.

# ------------------------------------------------------------------ Z-API
# Servico hospedado de WhatsApp. Os dois primeiros identificam a instancia e
# viajam na propria URL das chamadas -- sao credenciais, nunca vao ao git.
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
# O painel da Z-API chama de "Token de Seguranca da Conta". Nasce desligado la',
# e por isso e' opcional aqui -- mas, uma vez ativado, toda chamada sem ele
# passa a ser recusada.
ZAPI_CLIENT_TOKEN=""
# So' para apontar a um proxy da Z-API. Vazio usa o endereco deles.
ZAPI_BASE_URL=""

# Com WAHA e Z-API configurados ao mesmo tempo, diz qual vale. Sozinho, quem
# decide e' a presenca das variaveis.
WHATSAPP_PROVIDER=""

# ------------------------------------------------------- Agente do grupo (VPS)
# Segredo compartilhado com o agente que aceita no grupo quem ja' e' membro.
# O mesmo valor tem que estar no /etc/sm-agente.env da VPS; sem ele, a rota
# recusa o agente e ninguem entra automaticamente.
# Gere com: openssl rand -hex 32
AGENTE_SECRET=""

# ------------------------------------------------------------------ WAHA
WAHA_BASE_URL="http://localhost:3001"
# Na VPS esta chave e' obrigatoria: ela e' o que impede que qualquer um controle
# a sessao de WhatsApp da comunidade. Gere com: openssl rand -hex 24
WAHA_API_KEY=""
WAHA_SESSION="default"

# ------------------------------------------------------------------ cron
# Protege /api/cron/*; envie como header `x-cron-secret`.
CRON_SECRET="troque-este-segredo"

# ------------------------------------------------------------------ VPS
# Usadas so' pelo docker-compose.prod.yml. Em desenvolvimento podem ficar
# vazias; na VPS o compose recusa subir sem elas.

# Dominio que serve a plataforma. Precisa ja' apontar para o IP da VPS antes do
# primeiro deploy: e' por ele que a Let's Encrypt valida o certificado.
APP_DOMAIN=""
# Endereco que recebe os avisos de expiracao de certificado.
ACME_EMAIL=""
# Senha do Postgres do container. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=""
# Fuso dos horarios do agendador.
TZ="America/Sao_Paulo"
# Por quantos dias os dumps ficam em backups/ antes do expurgo.
BACKUP_RETENTION_DAYS="14"

# ------------------------------------------------------------------ Stripe
# Sem as tres, a plataforma roda inteira e apenas sem o caminho de assinatura:
# o convite some da tela de login e o checkout responde que nao esta disponivel.
#
# Chave secreta da conta (Developers, API keys). Use a de teste ate a virada.
STRIPE_SECRET_KEY=""
# Segredo do endpoint de webhook (Developers, Webhooks), apontando para
# https://SEU_DOMINIO/api/stripe/webhook com estes eventos:
#   checkout.session.completed
#   customer.subscription.created, .updated, .deleted
#   invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""
# Id do preco recorrente (price_...). O valor em reais vive no Stripe, nao aqui:
# mudar a mensalidade nao pode exigir um deploy.
STRIPE_PRICE_PADRAO=""
